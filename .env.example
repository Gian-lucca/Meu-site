# Copie este arquivo para .env e preencha com os seus dados.
# O .env esta no .gitignore, entao suas chaves nao vao para o repo.
#
# No painel do EmailJS:
#   service id  -> aba "Email Services" -> copie o Service ID
#   template id -> aba "Email Templates" -> copie o Template ID
#   public key  -> aba "Account" -> Public Key
#
# Os nomes dos campos do formulario (from_name, reply_to, message) precisam
# bater com as variaveis usadas no template do EmailJS.

REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_TEMPLATE_ID=
REACT_APP_EMAILJS_PUBLIC_KEY=